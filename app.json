{
  "expo": {
    "name": "أساطير الكرة",
    "slug": "asatyr-alkrh",
    "owner": "asser96s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asateer",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "29a8bb5b-2daa-4c34-8658-c3b845cca05a"
      }
    },
    "android": {
      "package": "com.asser96.asateeralkora"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
